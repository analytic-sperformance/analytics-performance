   "source": [
    "#Создаем market_aggregates.csv\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "# ================= LOAD =================\n",
    "df = pd.read_csv(\n",
    "    \"market_snapshots.csv\",\n",
    "    parse_dates=[\"snapshot_time\", \"start_time\", \"last_update\"]\n",
    ")\n",
    "\n",
    "# ================= FILTER TOTALS =================\n",
    "df = df[df[\"over_under\"].notna()].copy()\n",
    "\n",
    "#df[\"market_type\"] = \"total\"\n",
    "\n",
    "# ================= SORT (CRITICAL) =================\n",
    "df = df.sort_values(\n",
    "    [\"event_id\", \"team\", \n",
    "     #\"market_type\", \n",
    "     \"snapshot_time\"]\n",
    ")\n",
    "\n",
    "# ================= AGGREGATION =================\n",
    "agg = df.groupby(\n",
    "    [\"event_id\", \"event_key\", \"team\", \n",
    "    # \"market_type\"\n",
    "    ],\n",
    "    as_index=False\n",
    ").agg(\n",
    "    opening_line=(\"line\", \"first\"),\n",
    "    closing_line=(\"line\", \"last\"),\n",
    "    line_median=(\"line\", \"median\"),\n",
    "    line_std=(\"line\", \"std\"),\n",
    "    odds_median=(\"odds\", \"median\"),\n",
    "    book_count=(\"bookmaker_key\", \"nunique\")\n",
    ")\n",
    "\n",
    "# ================= ROUND =================\n",
    "agg[\n",
    "    [\"opening_line\", \"closing_line\", \"line_median\", \"line_std\", \"odds_median\"]\n",
    "] = agg[\n",
    "    [\"opening_line\", \"closing_line\", \"line_median\", \"line_std\", \"odds_median\"]\n",
    "].round(3)\n",
    "\n",
    "# ================= SAVE =================\n",
    "agg.sort_values(\"event_key\").to_csv(\"market_aggregates.csv\", index=False)\n",
    "\n",
    "print(\"Saved market_aggregates.csv\")\n"
   ]
  },
