   "source": [
    "#Создаем market_snapshots.csv\n",
    "\n",
    "import os\n",
    "import requests\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime\n",
    "\n",
    "# ================= CONFIG ================= #\n",
    "\n",
    "TEAM_MAP = {\n",
    "    \"Atlanta Hawks\": \"Atlanta Hawks\",\n",
    "    \"Boston Celtics\": \"Boston Celtics\",\n",
    "    \"Brooklyn Nets\": \"Brooklyn Nets\",\n",
    "    \"Charlotte Hornets\": \"Charlotte Hornets\",\n",
    "    \"Chicago Bulls\": \"Chicago Bulls\",\n",
    "    \"Cleveland Cavaliers\": \"Cleveland Cavaliers\",\n",
    "    \"Dallas Mavericks\": \"Dallas Mavericks\",\n",
    "    \"Denver Nuggets\": \"Denver Nuggets\",\n",
    "    \"Detroit Pistons\": \"Detroit Pistons\",\n",
    "    \"Golden State Warriors\": \"Golden State Warriors\",\n",
    "    \"Houston Rockets\": \"Houston Rockets\",\n",
    "    \"Indiana Pacers\": \"Indiana Pacers\",\n",
    "    \"LA Clippers\": \"LA Clippers\",\n",
    "    \"Los Angeles Clippers\": \"LA Clippers\",\n",
    "    \"Los Angeles Lakers\": \"Los Angeles Lakers\",\n",
    "    \"Memphis Grizzlies\": \"Memphis Grizzlies\",\n",
    "    \"Miami Heat\": \"Miami Heat\",\n",
    "    \"Milwaukee Bucks\": \"Milwaukee Bucks\",\n",
    "    \"Minnesota Timberwolves\": \"Minnesota Timberwolves\",\n",
    "    \"New Orleans Pelicans\": \"New Orleans Pelicans\",\n",
    "    \"New York Knicks\": \"New York Knicks\",\n",
    "    \"Oklahoma City Thunder\": \"Oklahoma City Thunder\",\n",
    "    \"Orlando Magic\": \"Orlando Magic\",\n",
    "    \"Philadelphia 76ers\": \"Philadelphia 76ers\",\n",
    "    \"Phoenix Suns\": \"Phoenix Suns\",\n",
    "    \"Portland Trail Blazers\": \"Portland Trail Blazers\",\n",
    "    \"Sacramento Kings\": \"Sacramento Kings\",\n",
    "    \"San Antonio Spurs\": \"San Antonio Spurs\",\n",
    "    \"Toronto Raptors\": \"Toronto Raptors\",\n",
    "    \"Utah Jazz\": \"Utah Jazz\",\n",
    "    \"Washington Wizards\": \"Washington Wizards\",\n",
    "}\n",
    "\n",
    "BASE_URL = \"https://api.the-odds-api.com/\"\n",
    "#API_KEY = \"import os

API_KEY = os.getenv("THE_ODDS_API_KEY")

if not API_KEY:
    raise ValueError("THE_ODDS_API_KEY environment variable is not set")\" #1\n",
    "SPORT = \"basketball_nba\"\n",
    "REGION = \"us\"\n",
    "MARKET = \"team_totals\"\n",
    "\n",
    "HISTORY_FILE = \"market_snapshots.csv\"\n",
    "\n",
    "# ================= HELPERS ================= #\n",
    "\n",
    "def log(msg):\n",
    "    print(f\"[{datetime.utcnow().strftime('%H:%M:%S')}] {msg}\")\n",
    "\n",
    "def assert_columns(df, cols, name):\n",
    "    missing = set(cols) - set(df.columns)\n",
    "    if missing:\n",
    "        raise ValueError(f\"❌ {name} missing columns: {missing}\")\n",
    "\n",
    "def align_to_history(df_new: pd.DataFrame, df_hist: pd.DataFrame) -> pd.DataFrame:\n",
    "    # 1. добавить отсутствующие колонки\n",
    "    for col in df_hist.columns:\n",
    "        if col not in df_new.columns:\n",
    "            df_new[col] = np.nan\n",
    "\n",
    "    # 2. удалить лишние (если вдруг)\n",
    "    df_new = df_new[df_hist.columns]\n",
    "\n",
    "    return df_new\n",
    "\n",
    "def make_event_key(start_time, home, away):\n",
    "    if pd.isna(start_time) or pd.isna(home) or pd.isna(away):\n",
    "        return pd.NA\n",
    "\n",
    "    date = pd.to_datetime(start_time, errors=\"coerce\")\n",
    "    if pd.isna(date):\n",
    "        return pd.NA\n",
    "\n",
    "    return f\"{date.strftime('%Y-%m-%d')}_{home}_{away}\"\n",
    "\n",
    "# ================= NORMALIZATION ================= #\n",
    "\n",
    "CANON_COLS = [\n",
    "    \"event_id\",\n",
    "    \"start_time\",\n",
    "    \"home_team\",\n",
    "    \"away_team\",\n",
    "    \"bookmaker_key\",\n",
    "    \"bookmaker_title\",\n",
    "    \"team\",\n",
    "    \"over_under\",\n",
    "    \"line\",\n",
    "    \"odds\",\n",
    "    \"last_update\",\n",
    "    \"snapshot_time\",\n",
    "    \"event_key\",\n",
    "]\n",
    "\n",
    "\n",
    "def normalize_schema(df: pd.DataFrame, name=\"df\") -> pd.DataFrame:\n",
    "    df = df.copy()\n",
    "\n",
    "    # гарантируем все колонки\n",
    "    for col in CANON_COLS:\n",
    "        if col not in df.columns:\n",
    "            df[col] = pd.NA\n",
    "\n",
    "    # лишние колонки выкидываем\n",
    "    df = df[CANON_COLS]\n",
    "\n",
    "    # ---- types ----\n",
    "    df[\"event_id\"] = df[\"event_id\"].astype(str)\n",
    "    df[\"event_key\"] = df[\"event_key\"].astype(str)\n",
    "\n",
    "    df[\"team\"] = df[\"team\"].map(TEAM_MAP)\n",
    "    df[\"home_team\"] = df[\"home_team\"].map(TEAM_MAP)\n",
    "    df[\"away_team\"] = df[\"away_team\"].map(TEAM_MAP)\n",
    "\n",
    "    df[\"start_time\"] = pd.to_datetime(df[\"start_time\"], utc=True, errors=\"coerce\")\n",
    "    df[\"snapshot_time\"] = pd.to_datetime(df[\"snapshot_time\"], utc=True, errors=\"coerce\")\n",
    "    df[\"line\"] = pd.to_numeric(df[\"line\"], errors=\"coerce\")\n",
    "\n",
    "    # ---- Opp ----\n",
    "    df[\"Opp\"] = np.where(\n",
    "        df[\"team\"] == df[\"home_team\"],\n",
    "        df[\"away_team\"],\n",
    "        df[\"home_team\"]\n",
    "    )\n",
    "\n",
    "    # ---- row_key ----\n",
    "    df[\"row_key\"] = (\n",
    "        df[\"event_key\"] + \"_\" +\n",
    "        df[\"bookmaker_key\"] + \"_\" +\n",
    "        df[\"over_under\"] + \"_\" +\n",
    "        df[\"line\"].astype(str) + \"_\" +\n",
    "        df[\"snapshot_time\"].astype(str)\n",
    "    )\n",
    "    \n",
    "    if df[\"snapshot_time\"].isna().any():\n",
    "        log(f\"⚠️ {name}: snapshot_time contains NaT — filling with current time\")\n",
    "        df[\"snapshot_time\"] = df[\"snapshot_time\"].fillna(pd.Timestamp.utcnow())\n",
    "\n",
    "    # ---- validation ----\n",
    "    assert df[\"event_key\"].isna().sum() == 0, \"event_key contains NaN\"\n",
    "    assert df[\"row_key\"].isna().sum() == 0, \"row_key contains NaN\"\n",
    "\n",
    "    return df\n",
    "\n",
    "# ================= FETCH ================= #\n",
    "\n",
    "def fetch_future_odds() -> pd.DataFrame:\n",
    "    now = datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n",
    "\n",
    "    r = requests.get(\n",
    "        f\"{BASE_URL}v4/sports/{SPORT}/events\",\n",
    "        params={\n",
    "            \"apiKey\": API_KEY,\n",
    "            \"regions\": REGION,\n",
    "            \"commenceTimeFrom\": now\n",
    "        }\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        events = r.json()\n",
    "    except Exception:\n",
    "        log(f\"❌ Failed to decode JSON: {r.text[:300]}\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    if not isinstance(events, list):\n",
    "        log(f\"❌ Unexpected events response: {events}\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for e in events:\n",
    "        event_id = e[\"id\"]\n",
    "\n",
    "        odds = requests.get(\n",
    "            f\"{BASE_URL}v4/sports/{SPORT}/events/{event_id}/odds\",\n",
    "            params={\n",
    "                \"apiKey\": API_KEY,\n",
    "                \"regions\": REGION,\n",
    "                \"markets\": MARKET\n",
    "            }\n",
    "        ).json()\n",
    "\n",
    "        for bm in odds.get(\"bookmakers\", []):\n",
    "            for m in bm.get(\"markets\", []):\n",
    "                if m[\"key\"] != \"team_totals\":\n",
    "                    continue\n",
    "\n",
    "                for o in m[\"outcomes\"]:\n",
    "                    rows.append({\n",
    "                        \"event_id\": event_id,\n",
    "                        \"start_time\": e[\"commence_time\"],\n",
    "                        \"home_team\": e[\"home_team\"],\n",
    "                        \"away_team\": e[\"away_team\"],\n",
    "                        \"team\": o[\"description\"],\n",
    "                        \"bookmaker_key\": bm[\"key\"],\n",
    "                        \"bookmaker_title\": bm[\"title\"],\n",
    "                        \"over_under\": o[\"name\"],\n",
    "                        \"line\": o[\"point\"],\n",
    "                        \"odds\": o[\"price\"],\n",
    "                        \"snapshot_time\": now,\n",
    "                    })\n",
    "\n",
    "    df = pd.DataFrame(rows)\n",
    "    log(f\"Fetched {len(df)} rows from API\")\n",
    "    return df\n",
    "\n",
    "# ================= MAIN ================= #\n",
    "\n",
    "def run_incremental():\n",
    "    # ---- history ----\n",
    "    if os.path.exists(HISTORY_FILE):\n",
    "        df_hist = pd.read_csv(HISTORY_FILE)\n",
    "        df_hist = normalize_schema(df_hist, \"history\")\n",
    "        \n",
    "        df_hist = df_hist.drop(columns=\"event_key\")\n",
    "        df_hist[\"event_key\"] = df_hist.apply(\n",
    "            lambda r: make_event_key(\n",
    "                r[\"start_time\"],\n",
    "                r[\"home_team\"],\n",
    "                r[\"away_team\"]\n",
    "            ),\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        \n",
    "        hist_keys = set(df_hist[\"row_key\"])\n",
    "        log(f\"Loaded history: {len(df_hist)} rows\")\n",
    "    else:\n",
    "        df_hist = pd.DataFrame()\n",
    "        hist_keys = set()\n",
    "        log(\"No history file\")\n",
    "\n",
    "    # ---- fetch ----\n",
    "    df_new = fetch_future_odds()\n",
    "    if df_new.empty:\n",
    "        log(\"No new odds fetched\")\n",
    "        return\n",
    "    df_new = normalize_schema(df_new, \"new\")\n",
    "    df_new[\"event_key\"] = df_new.apply(\n",
    "        lambda r: make_event_key(\n",
    "            r[\"start_time\"],\n",
    "            r[\"home_team\"],\n",
    "            r[\"away_team\"]\n",
    "        ),\n",
    "        axis=1\n",
    "    )\n",
    "    \n",
    "    if not df_hist.empty:\n",
    "        df_new = align_to_history(df_new, df_hist)\n",
    "    else:\n",
    "        log(\"No new odds fetched\")\n",
    "        return\n",
    "\n",
    "    df_all = pd.concat([df_hist, df_new], ignore_index=True)\n",
    "    df_all = df_all.drop_duplicates(subset=[\"row_key\"])\n",
    "    df_all.sort_values(\n",
    "        [\"start_time\", \"snapshot_time\", \"event_key\", \"team\", \"over_under\", \"line\"],\n",
    "        inplace=True\n",
    "    )\n",
    "\n",
    "    df_all.to_csv(HISTORY_FILE, index=False)\n",
    "\n",
    "    log(\"✅ Append complete\")\n",
    "\n",
    "# ================= RUN ================= #\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run_incremental()\n"
   ]
  },
