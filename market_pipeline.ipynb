     "text": [
      "[06:10:51] ⚠️ history: snapshot_time contains NaT — filling with current time\n",
      "[06:10:51] Loaded history: 5922 rows\n",
      "[06:10:56] Fetched 28 rows from API\n",
      "[06:10:56] ✅ Append complete\n"
     ]
